{
  "description": "The Plug - session recap hooks. Auto-briefs you when you've been away.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/check-gap.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
