{
  "mcpServers": {
    "chroma": {
      "command": "bash",
      "args": [
        "-c",
        "root=\"$1\"; [ -d \"$root\" ] || root=.; exec bash \"$root/hooks/scripts/chroma-mcp.sh\"",
        "code-crib-chroma",
        "${CLAUDE_PLUGIN_ROOT}"
      ],
      "cwd": ".",
      "env_vars": [
        "CHROMA_CLIENT_TYPE",
        "CHROMA_SSL",
        "CHROMA_HOST",
        "CHROMA_PORT",
        "CHROMA_CUSTOM_AUTH_CREDENTIALS",
        "CHROMA_DATA_DIR",
        "CHROMA_TENANT",
        "CHROMA_DATABASE",
        "CHROMA_API_KEY"
      ],
      "disabled": false
    }
  }
}
